# ─────────────────────────────────────────────────────────────────────────────
# Hisab — environment variables. Copy to `.env` for local development.
# NEVER commit real values. On Vercel, set these in Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (Neon PostgreSQL) ───────────────────────────────────────────────
# POOLED connection string (host contains "-pooler") — used by the app at runtime on Vercel.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/hisab?sslmode=require&channel_binding=require"
# DIRECT (non-pooled) connection string — used by Prisma CLI for migrations / seed / studio.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/hisab?sslmode=require&channel_binding=require"

# ── Auth.js ──────────────────────────────────────────────────────────────────
# Generate with:  npx auth secret   or   openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"
# Public URL of the app (no trailing slash). Optional on Vercel (auto-detected), required elsewhere.
AUTH_URL="http://localhost:3000"
# Base URL used in email links (verification / password reset).
APP_URL="http://localhost:3000"

# ── Email verification ───────────────────────────────────────────────────────
# "on" = users must verify their email before signing in (requires Resend below).
# Anything else (default) = accounts are active immediately after registration.
EMAIL_VERIFICATION="off"

# ── Email (Resend — https://resend.com) ──────────────────────────────────────
# Required in production for email verification and password reset.
# In development, leave RESEND_API_KEY empty and the links are printed to the server console.
RESEND_API_KEY=""
# Sender on a domain you have verified in Resend, e.g. "Hisab <no-reply@yourdomain.com>"
EMAIL_FROM="Hisab <onboarding@resend.dev>"

# ── Vercel Cron ──────────────────────────────────────────────────────────────
# Protects /api/cron/recurring. Vercel sends it automatically as a Bearer token.
# Generate with: openssl rand -hex 24
CRON_SECRET="replace-with-a-random-string"
